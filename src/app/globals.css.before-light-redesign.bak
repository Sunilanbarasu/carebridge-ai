
* { box-sizing: border-box; }

:root {
  color-scheme: dark;
  --bg: #101716;
  --panel: #17211e;
  --line: #2b3b35;
  --text: #edf5f0;
  --muted: #a4b6ad;
  --accent: #6ee7b7;
}

html, body { margin: 0; min-height: 100%; }

body {
  background: var(--bg);
  color: var(--text);
  font: 15px/1.7 "Cascadia Code", Consolas, monospace;
}

button, textarea, select { font: inherit; }
button { cursor: pointer; }

.site-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 22px max(24px, calc((100% - 1200px) / 2));
  border-bottom: 1px solid var(--line);
}

.brand { display: flex; align-items: center; gap: 14px; }
.brand-icon {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  border-radius: 10px;
  background: var(--accent);
  color: #101716;
  font-weight: bold;
}

.brand h1 { margin: 0; font-size: 21px; }
.brand p, .privacy-label { margin: 0; font-size: 11px; letter-spacing: 1px; }
.privacy-label { color: var(--accent); }

.page-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 300px;
  gap: 32px;
  max-width: 1200px;
  margin: auto;
  padding: 48px 24px;
}

.eyebrow {
  color: var(--accent);
  font-size: 11px;
  letter-spacing: 1.5px;
}

h2 {
  max-width: 760px;
  margin: 20px 0;
  font-size: clamp(34px, 4.5vw, 56px);
  line-height: 1.15;
  letter-spacing: -2px;
}

.intro, .info-card p { color: var(--muted); }

.panel, .info-card {
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--panel);
  padding: 22px;
}

.panel { margin-top: 30px; }

.panel-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 14px;
  margin-bottom: 18px;
}

.panel h3, .info-card h3 { margin: 0; font-size: 16px; }

button {
  border: 1px solid var(--line);
  border-radius: 9px;
  padding: 11px 14px;
  background: #111916;
  color: var(--text);
}

.secondary-button:hover { border-color: var(--accent); }

textarea, select {
  display: block;
  width: 100%;
  margin-top: 9px;
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: #0d1311;
  color: var(--text);
}

textarea { min-height: 230px; resize: vertical; }

.counter { color: var(--muted); text-align: right; font-size: 12px; }

.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.form-grid label { font-size: 13px; }

.primary-button {
  width: 100%;
  margin-top: 22px;
  padding: 14px;
  background: var(--accent);
  color: #101716;
  font-weight: bold;
}

.primary-button:disabled { opacity: .45; cursor: not-allowed; }

.disclaimer { color: var(--muted); font-size: 12px; }

.sidebar { display: flex; flex-direction: column; gap: 16px; padding-top: 40px; }
.info-card .eyebrow { font-size: 10px; }
.info-card h3 { margin: 12px 0; }
.warning-card { border-color: #66502a; }
.warning-card .eyebrow { color: #f5c978; }
.info-card ol { padding-left: 22px; color: var(--muted); }

.site-footer {
  border-top: 1px solid var(--line);
  padding: 22px;
  color: var(--muted);
  text-align: center;
  font-size: 11px;
}

@media (max-width: 800px) {
  .page-layout { grid-template-columns: 1fr; padding: 28px 16px; }
  .sidebar { padding-top: 0; }
  .site-header { padding: 18px 16px; }
}

@media (max-width: 480px) {
  .form-grid { grid-template-columns: 1fr; }
  .privacy-label { display: none; }
  .panel { padding: 16px; }
  h2 { letter-spacing: -1px; }
}

/* CareBridge AI analysis results */
.results-panel {
  margin-top: 24px;
  overflow-wrap: anywhere;
}

.result-summary {
  font-size: 1.08rem;
  line-height: 1.7;
}

.result-section {
  margin-top: 28px;
  padding-top: 20px;
  border-top: 1px solid var(--border, #30363d);
}

.result-section h3 {
  margin-bottom: 14px;
}

.result-section ul,
.result-section ol {
  padding-left: 22px;
}

.result-section li {
  margin: 9px 0;
  line-height: 1.6;
}

.finding-card {
  margin: 14px 0;
  padding: 16px;
  border: 1px solid var(--border, #30363d);
  border-radius: 10px;
  overflow-wrap: anywhere;
}

.finding-heading {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.finding-heading h4,
.finding-card h4 {
  margin: 0;
}

.finding-category {
  font-size: 0.85rem;
  opacity: 0.75;
}

.finding-card blockquote {
  margin: 14px 0;
  padding: 10px 14px;
  border-left: 3px solid var(--accent, #8b9cff);
  background: rgba(127, 127, 127, 0.08);
  line-height: 1.65;
}

.status-tag {
  display: inline-block;
  border: 1px solid currentColor;
  border-radius: 5px;
  padding: 4px 8px;
  font-size: 0.75rem;
}

.loading-message,
.error-message {
  margin-top: 16px;
  padding: 14px;
  border: 1px solid var(--border, #30363d);
  border-radius: 9px;
  line-height: 1.6;
}

.error-message {
  border-color: #b85b5b;
}

.error-message p {
  overflow-wrap: anywhere;
}

@media (max-width: 600px) {
  .finding-heading {
    align-items: flex-start;
  }

  .results-panel {
    padding: 16px;
  }
}

/* CareBridge image OCR controls */
.image-input-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 14px 0;
}

.image-picker {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  position: relative;
}

.image-picker input[type="file"] {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  opacity: 0;
}

.image-picker:focus-within {
  outline: 2px solid currentColor;
  outline-offset: 3px;
}

.image-picker:has(input:disabled) {
  opacity: 0.55;
  cursor: not-allowed;
}

@media (max-width: 480px) {
  .image-input-row {
    flex-direction: column;
  }

  .image-picker {
    width: 100%;
  }
}


.image-controls { display:flex; flex-wrap:wrap; gap:10px; margin:12px 0 8px; }
.image-controls input[type=file] { display:none; }
.image-upload-button { display:inline-flex; align-items:center; justify-content:center; cursor:pointer; }
.image-upload-button:hover { border-color:var(--accent, #65e6b8); }

/* CareBridge AI — document image controls */
.image-controls {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 14px 0;
}

.image-controls input[type="file"] {
  display: none;
}

.image-upload-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42px;
  padding: 0 16px;
  border: 1px solid #30463e;
  border-radius: 8px;
  background: #101a16;
  color: #e4eee9;
  font: inherit;
  cursor: pointer;
  transition: border-color 160ms ease, background 160ms ease;
}

.image-upload-button:hover {
  border-color: #65e6b8;
  background: #192a23;
}

.image-upload-button:focus-within {
  outline: 2px solid #65e6b8;
  outline-offset: 3px;
}

